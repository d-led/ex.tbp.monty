*.vsix

### VisualStudioCode Patch ###
# Ignore all local history of files
.history
.ionide

# End of https://www.toptal.com/developers/gitignore/api/phoenix,elixir,visualstudiocode,node

var/k6/
/var/

# Ignore digested assets cache.
/priv/static/cache_manifest.json

# In case you use Node.js/npm, you want to ignore these.
npm-debug.log
/assets/node_modules/

# Also ignore archive artifacts (built via "mix archive.build").
*.ez

# Temporary files, for example, from tests.
/tmp/
priv/static/assets/

# Deployment secrets, copied from the checked-in examples and filled in by
# whoever deploys. The examples themselves stay tracked.
deploy/k8s/secret.yaml
.env

# Written by `mix build.info` at build time: it describes one build of one
# checkout, so a checked-in copy would be a lie about every other build.
priv/build_info.json

# database dumps taken by scripts/fly-pg-backup.sh
backups/

# The native kernels, built by rustler from `native/*` during compile: a shared
# object is this machine's, not the repository's.
/priv/native/

# Dialyzer PLTs are built locally and cached in CI
/priv/plts/

# Studio runs write their logs here; they are not source.
/priv/studio_runs/

# running a recorder writes bytecode, and a .pyc embeds its source's absolute path
__pycache__/
*.pyc

# the throwaway Python environment `scripts/setup_monty_oracle.sh` builds
.monty-oracle/

# A wandb run writes its own directory beside whatever started it. The runs are
# artifacts, not source, and an online test one day wrote one into this repo.
/wandb/
wandb/

# The embedded interpreter `pythonx` builds from `config/pythonx.exs`. It lives
# under `_build`, but a stray venv beside the project is the same mistake.
.venv/

# Whatever a run downloads or generates into Monty's own paths.
/data/
MUJOCO_LOG.TXT

# JUnit reports written when `CI` is set, for the Checks tab to read.
/junit/

# The window crate is built locally, not committed.
/src-tauri/target/
/src-tauri/gen/schemas/

# What `scripts/package.sh` produces: an app, a zip and a disk image of it.
/artifacts/

# The window wants a `frontendDist` directory to exist; this one is a fallback
# page that is never shown and is committed on purpose.
!/src-tauri/dist/
