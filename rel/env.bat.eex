@echo off
rem Set the release to load code on demand (interactive) instead of preloading (embedded).
rem set RELEASE_MODE=interactive

rem Set the release to work across nodes.
rem RELEASE_DISTRIBUTION must be sname (local), name (distributed) or none.
rem set RELEASE_DISTRIBUTION=name
rem set RELEASE_NODE=<%= @release.name %>

rem ---------------------------------------------------------------------------
rem The desktop window, which is the one branch this file has to say itself.
rem
rem `rel/env.sh.eex` is the rule for every other home this release has; a release
rem started by `bin\server.bat` sources this file instead, so the same branch is
rem repeated here rather than left to drift. Kept identical on purpose: a window
rem named `monty-studio-<instance id>` on macOS and an unnamed node on Windows is
rem a cluster that half works, and the half that does not is the one that is
rem hardest to see.
rem
rem `MONTY_STUDIO_CLUSTER=0` starts one undistributed node and nothing else.
rem `MONTY_STUDIO_INSTANCE_ID` overrides the id, and an explicit `RELEASE_NODE`
rem wins over both.
rem ---------------------------------------------------------------------------
if not defined EX_TBP_MONTY_WINDOW goto :ex_tbp_monty_distribution_default
if defined RELEASE_NODE goto :ex_tbp_monty_distribution_default

if /i "%MONTY_STUDIO_CLUSTER%"=="0" (
  set "RELEASE_DISTRIBUTION=none"
  set "MONTY_CLUSTER=0"
  echo release node: none (clustering off: MONTY_STUDIO_CLUSTER=0)
  goto :ex_tbp_monty_distribution_done
)

if not defined MONTY_STUDIO_INSTANCE_ID set "MONTY_STUDIO_INSTANCE_ID=%RANDOM%%RANDOM%"
set "RELEASE_DISTRIBUTION=sname"
set "RELEASE_NODE=monty-studio-%MONTY_STUDIO_INSTANCE_ID%"
set "MONTY_CLUSTER=1"
echo release node: %RELEASE_NODE% (distribution: %RELEASE_DISTRIBUTION%)
goto :ex_tbp_monty_distribution_done

:ex_tbp_monty_distribution_default
rem Nothing: the release's own defaults, or a name the operator gave it.

:ex_tbp_monty_distribution_done
