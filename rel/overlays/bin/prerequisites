#!/bin/sh
#
# The data a run reads, as a step before the server: the image carries the
# software and Monty's config tree and no datasets, so a first start downloads
# them here. A deployment that would rather fetch before serving runs this as
# its own container — the compose files in this repository leave the fetching to
# the server, which does it in the background; every start after the first finds
# the bundles on the volume and does nothing.
#
# The schema comes first, the way `server` does it: this is the step a *fresh*
# volume gets, and starting the application sweeps the run table — the reaper's
# first query on a volume with no migrations stops the boot. On a volume that is
# already up to date the migrate step writes nothing.
#
# It exits non-zero when a download does not arrive, which is deliberate: a
# server that started anyway would offer runs whose model is missing.
set -eu

cd -P -- "$(dirname -- "$0")"
./ex_tbp_monty eval "ExTbpMonty.Release.migrate"
exec ./ex_tbp_monty eval "ExTbpMonty.Release.fetch_prerequisites"
