{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Monty Plugin Node",
  "version": "0.1.0",
  "identifier": "dev.ex-tbp-monty.plugin-window",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Monty plugin node",
        "width": 460,
        "height": 300,
        "resizable": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/icon.png"]
  }
}
